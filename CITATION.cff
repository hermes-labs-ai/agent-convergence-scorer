    given-names: "Rolando"
    orcid: "https://orcid.org/0009-0005-4896-1112"
    affiliation: "Hermes Labs"
version: "0.2.0"
license: MIT
repository-code: "https://github.com/hermes-labs-ai/agent-convergence-scorer"
keywords:
  - "AI reliability"
  - "LLM reliability"
  - "behavioral evaluation"
  - "silent failure modes"
  - "agent convergence"
  - "non-determinism"
  - "run-to-run agreement"
  - "Jaccard token overlap"
references:
